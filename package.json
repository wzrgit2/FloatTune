{
  "name": "floattune",
  "productName": "FloatTune",
  "version": "1.4.1",
  "private": true,
  "author": "Lining",
  "description": "FloatTune - a floating desktop media controller for Windows (controls whatever is playing via the system media API)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:mock": "cross-env MW_FAKE=1 electron .",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.floattune.app",
    "productName": "FloatTune",
    "asar": false,
    "files": [
      "src/**/*",
      "bridge/**/*",
      "tools/mock-bridge.js",
      "native/*.exe",
      "native/*.dll",
      "native/*.json",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FloatTune",
      "artifactName": "FloatTune-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "FloatTune-Portable-${version}.exe"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "license": "MIT"
}
